# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다. (NF3001)

# SSAFY GMS (OpenAI 호환) — 요청 분석, 인사·용어 답변, (심화) RAG 임베딩
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 금융감독원 금융상품한눈에 Open API 인증키 — 상품 후보·상세 조회
FSS_API_KEY=

# 공공데이터포털 국토교통부 아파트 매매 실거래가 일반 인증키 (Decoding 키 권장) — 시세 조회
MOLIT_API_KEY=

# 카카오 디벨로퍼스 REST API 키 — 은행 지점 검색
KAKAO_REST_API_KEY=

# 연습용 모드 (키·네트워크 없이 화면 확인): 1 이면 tests/fixtures 의 가상 응답·규칙 기반 LLM 대역 사용
PLANNER_FAKE_APIS=0
PLANNER_FAKE_LLM=0

# 0 이면 로깅 Agent 를 연결하지 않고 실행 (F3012 분리 확인용)
LOGGING_AGENT=1
